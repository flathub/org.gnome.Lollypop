{
    "app-id": "org.gnome.Lollypop",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "lollypop",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=xdg-music",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets",
        "--own-name=org.mpris.MediaPlayer2.Lollypop",
        "--metadata=X-DConf=migrate-path=/org/gnome/Lollypop/"
    ],
    "modules": [
        "pypi-dependencies.json",
        {
            "name": "gmime",
            "config-opts": [
                "--disable-gtk-doc"
            ],
            "cleanup": [
                "*.la",
                "/share/gtk-doc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gmime/3.2/gmime-3.2.7.tar.xz",
                    "sha256": "2aea96647a468ba2160a64e17c6dc6afe674ed9ac86070624a3f584c10737d44",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13124,
                        "url-template": "https://download.gnome.org/sources/gmime/3.2/gmime-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "totem-pl-parser",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/totem-pl-parser/3.26/totem-pl-parser-3.26.7.tar.xz",
                    "sha256": "60d517c1acabe54ae337f64451264fc76730696eaae26b5480fb37166689b5f3",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13163,
                        "url-template": "https://download.gnome.org/sources/totem-pl-parser/3.26/totem-pl-parser-$version.tar.xz"
                    }
                }
            ],
            "cleanup": [
                "/include",
                "/share/gtk-doc"
            ]
        },
        {
            "name": "libhandy",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libhandy/1.8/libhandy-1.8.3.tar.xz",
                    "sha256": "05b497229073ff557f10b326e074c5066f8743a302d4820ab97bcb5cd2dab087",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13163,
                        "url-template": "https://download.gnome.org/sources/libhandy/1.8/libhandy-$version.tar.xz"
                    }
                }
            ],
            "cleanup": [
                "/include",
                "/share/gtk-doc"
            ]
        },
        {
            "name": "lollypop",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/World/lollypop.git",
                    "tag": "1.4.48",
                    "commit": "2884445fbb786ff9daff23fd33b61901ec1128c0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
